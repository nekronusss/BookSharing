# Set these variables in the backend process environment. Spring does not load .env automatically.
DB_URL=jdbc:postgresql://localhost:5432/booksharing
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Only for a local development database. Production requires versioned migrations.
DDL_AUTO=update
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Backend only. Use scripts/start-backend.ps1 to load this file as environment.
AI_ENABLED=false
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
AI_API_KEY=
AI_CHAT_MODEL=qwen2.5:7b
AI_EMBEDDING_MODEL=bge-m3
AI_TIMEOUT_SECONDS=120
AI_DAILY_CALL_BUDGET=1000
AI_REQUESTS_PER_MINUTE=12
AI_SIMILARITY_THRESHOLD=0.45
AI_INDEX_BATCH_SIZE=16
AI_INDEX_DELAY_MS=30000
